{
  "name": "got-stat",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @got-stat/web",
    "dev:web": "npm run dev -w @got-stat/web",
    "dev:api": "npm run dev -w @got-stat/api",
    "build": "npm run build -w @got-stat/web",
    "build:web": "npm run build -w @got-stat/web",
    "build:api": "npm run type-check -w @got-stat/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "npm run type-check -w @got-stat/web && npm run type-check -w @got-stat/api && npm run type-check -w @got-stat/shared",
    "db:up": "docker compose up -d db --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @got-stat/api",
    "db:seed": "npm run db:seed -w @got-stat/api",
    "db:import": "npm run db:import -w @got-stat/api",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run db:import"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@skepsik/eslint-config": "file:../eslint-config",
    "eslint": "^10.6.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.62.0"
  }
}
